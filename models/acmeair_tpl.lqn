G
"acmeair_1.lqn"
0.0001
500
1
0.5
-1

# Processors declaration, with multiplicity 
P 0
p ProcClient f m $USERS
p ProcMSauth f m $ProcMSauth
p ProcMSvalidateid f m $ProcMSvalidateid
p ProcMSviewprofile f m $ProcMSviewprofile
p ProcMSupdateprofile f m $ProcMSupdateprofile
p ProcMSupdateMiles f m $ProcMSupdateMiles
p ProcMSbookflights f m $ProcMSbookflights
p ProcMScancelbooking f m $ProcMScancelbooking
p ProcMSqueryflights f m $ProcMSqueryflights
p ProcMSgetrewardmiles f m $ProcMSgetrewardmiles
-1

# Tasks declaration
T 0
t client r clientEntry -1 ProcClient m $USERS
t MSauth n MSauthEntry -1 ProcMSauth m $USERS
t MSvalidateid n MSvalidateidEntry -1 ProcMSvalidateid m $USERS
t MSviewprofile n MSviewprofileEntry -1 ProcMSviewprofile m $USERS
t MSupdateprofile n MSupdateprofileEntry -1 ProcMSupdateprofile m $USERS
t MSupdateMiles n MSupdateMilesEntry -1 ProcMSupdateMiles m $USERS
t MSbookflights n MSbookflightsEntry -1 ProcMSbookflights m $USERS
t MScancelbooking n MScancelbookingEntry -1 ProcMScancelbooking m $USERS
t MSqueryflights n MSqueryflightsEntry -1 ProcMSqueryflights m $USERS
t MSgetrewardmiles n MSgetrewardmilesEntry -1 ProcMSgetrewardmiles m $USERS
-1

# Entries declaration
E 0
s clientEntry 1.0 -1
y clientEntry MSviewprofileEntry 2.0 -1
y clientEntry MSupdateprofileEntry 1.0 -1
y clientEntry MSbookflightsEntry 1.0 -1
y clientEntry MScancelbookingEntry 2.0 -1
y clientEntry MSqueryflightsEntry 1.0 -1
s MSauthEntry 0.039025 -1
y MSauthEntry MSvalidateidEntry 1.0 -1
s MSvalidateidEntry 0.024734 -1
s MSviewprofileEntry 0.033605 -1
s MSupdateprofileEntry 0.049099 -1
s MSupdateMilesEntry 0.013853 -1
s MSbookflightsEntry 0.030366 -1
y MSbookflightsEntry MSupdateMilesEntry 2.0 -1
y MSbookflightsEntry MSgetrewardmilesEntry 2.0 -1
s MScancelbookingEntry 0.025745 -1
y MScancelbookingEntry MSupdateMilesEntry 1.0 -1
y MScancelbookingEntry MSgetrewardmilesEntry 1.0 -1
s MSqueryflightsEntry 0.026019 -1
s MSgetrewardmilesEntry 0.012775 -1
y clientEntry MSauthEntry 1.0 -1
-1

# 1. Solver settings
#! v 1.0e5           	# fast rate to approximate instantaneous events
#! solver ode        	# ODE analysis - solver sim will run simulation
#! confidence_level 0.95
#! confidence_percent_error 0.01
#! stoptime 1000.0

# 2. Output settings
#! throughput: clientEntry MSauthEntry MSviewprofileEntry  MSvalidateidEntry MSupdateprofileEntry MSupdateMilesEntry MSbookflightsEntry MScancelbookingEntry MSqueryflightsEntry MSgetrewardmilesEntry
#! utilization: clientEntry MSauthEntry MSviewprofileEntry  MSvalidateidEntry MSupdateprofileEntry MSupdateMilesEntry MSbookflightsEntry MScancelbookingEntry MSqueryflightsEntry MSgetrewardmilesEntry
#! responsetime: clientEntry MSauthEntry MSviewprofileEntry  MSvalidateidEntry MSupdateprofileEntry MSupdateMilesEntry MSbookflightsEntry MScancelbookingEntry MSqueryflightsEntry MSgetrewardmilesEntry -1

# 3. Export settings
#! export csv